  "fixed_sql": [
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"default_portions\" INTEGER NOT NULL DEFAULT 4, \"default_meals_per_week\" INTEGER NOT NULL DEFAULT 5, \"repeat_cooldown_weeks\" INTEGER NOT NULL DEFAULT 6, \"planning_nudge_weekday\" INTEGER NULL, \"planning_nudge_minute_of_day\" INTEGER NULL, \"last_exported_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recipes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"serves\" INTEGER NOT NULL, \"method\" TEXT NOT NULL, \"edited_by_user\" INTEGER NOT NULL DEFAULT 0 CHECK (\"edited_by_user\" IN (0, 1)), \"kcal_per_portion\" INTEGER NULL, \"protein_g_per_portion\" REAL NULL, \"fat_g_per_portion\" REAL NULL, \"carbs_g_per_portion\" REAL NULL, \"source\" TEXT NOT NULL, \"cuisine\" TEXT NULL, \"time_minutes\" INTEGER NULL, \"difficulty\" TEXT NULL, \"primary_protein\" TEXT NULL, \"cooking_method\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "recipe_ingredients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_ingredients\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"recipe_id\" INTEGER NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"sort_order\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"quantity\" REAL NULL, \"unit\" TEXT NULL, \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "weekly_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weekly_plans\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"portions\" INTEGER NOT NULL, \"meal_count\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "suggestions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"suggestions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"weekly_plan_id\" INTEGER NOT NULL REFERENCES weekly_plans (id) ON DELETE CASCADE, \"slot_index\" INTEGER NOT NULL, \"recipe_id\" INTEGER NULL REFERENCES recipes (id) ON DELETE SET NULL, \"filled_via\" TEXT NULL, \"status\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    }
  ]
